## Server config

# Address for binding HTTP server
# Optional, defaults to "" (listen on 0.0.0.0)
#
# LIP_SERVER_ADDRESS="10.0.0.1"

# Port for binding HTTP server
# Optional, defaults to 3891
#
# LIP_SERVER_PORT=3891

# Cache TTL sent as the response Cache-Control max-age
# Optional, defaults to 12h
#
# LIP_SERVER_IMAGE_TTL=12h

## LDAP configuration

# LDAP server URL
# Required, eg. "ldap://10.8.0.1:3890"
#
# LIP_LDAP_URL=""

# LDAP base DN
# Required, eg. "dc=example,dc=org"
#
# LIP_LDAP_BASE_DN=""

# LDAP bind user
# Required, eg. "uid=ldap-image-proxy,ou=people,dc=example,dc=org"
#
# LIP_LDAP_BIND_USER=""

# LDAP bind user's password
# Required, unset automatically after configuration's load
#
# LIP_LDAP_BIND_PASSWORD=""

# LDAP implementation
# Required, one of [activedirectory, freeipa, glauth, lldap, rfc2307bis, custom], defaults to "custom"
#
# LIP_LDAP_IMPLEMENTATION="custom"

# LDAP avatar attribute
# Required, defaults to jpegphoto
#
# LIP_LDAP_ATTRIBUTE_AVATAR="jpegphoto"

# LDAP username attribute
# Required only for custom implementation, eg. "uid"
#
# LIP_LDAP_ATTRIBUTE_USERNAME=""

# LDAP mail attribute
# Required only for custom implementation, eg. "mail"
#
# LIP_LDAP_ATTRIBUTE_EMAIL=""

# LDAP user search filter
# Required only for custom implementation, eg. "(&(|(uid={input})(mail={input}))(objectClass=person))"
#
# Available format fields:
#   {username_attribute} - username attribute name (eg. "uid", resolved automatically for known implementations, value of LIP_LDAP_ATTRIBUTE_USERNAME for custom implementation)
#   {mail_attribute}     - mail attribute name (eg. "mail", resolved automatically for known implementations, value of LIP_LDAP_ATTRIBUTE_EMAIL for custom implementation)
#   {input}              - application search input
#   {datetime}           - current date & time as generalized UTC timestamp (2026-09-01 12:13:14 UTC -> 20260901121314.0Z)
#   {datetime-ms}        - current date & time as Microsoft NT Epoch (2026-09-01 12:13:14 UTC -> 134327383940000000)
#   {datetime-unix}      - current date & time as Unix Epoch (2026-09-01 12:13:14 UTC -> 1788264794)
#
# LIP_LDAP_SEARCH_FILTER=""

## Logging configuration

# Logging level
# Optional, defaults to "info"
#
# LIP_LOG_LEVEL=info

# Enable pretty logging (resource intensive, not recommended)
# Optional, defaults to false
#
# LIP_LOG_PRETTY=false
